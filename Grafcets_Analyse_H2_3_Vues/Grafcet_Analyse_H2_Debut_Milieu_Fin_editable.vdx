            <Value Unit="STR">[{"network": 43, "writer_part": "46", "destination": "Ech_Stand_Analyse.Analyseur.Popup_Temp_Analyse_IHM_ENV.Message", "source_expression": "CONCAT(in1 := S_Num_Stand, in2 := Temp_Wstring)", "scl_networks": [42]}]</Value>
