            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
          <Prop ID="6" NameU="Expressions_sources">
            <Value Unit="STR">[{"network": 11, "writer_part": "46", "destination": "Ech_Stand_Analyse.Analyseur.Popup_Temp_Analyse_IHM_ENV.Message", "source_expression": "CONCAT(in1 := S_Num_Stand, in2 := Temp_Wstring)", "scl_networks": [10]}]</Value>
            <Label Unit="STR">Expressions_sources</Label>
            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
          <Prop ID="7" NameU="Entete_R5">
            <Value Unit="STR">CONCAT(IN1 := WSTRING#'ETAPE N° ', IN2 := DELETE(IN := INT_TO_WSTRING(G7.G_X), L := 1, P := 1), IN3 := S_CRLF, IN4 := WSTRING#'SHELTER STAND ', IN5 := S_N_Stand, IN6 := S_CRLF, IN7 := S_Type, IN8 := S_CRLF)</Value>
            <Label Unit="STR">Entete_R5</Label>
            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
          <Geom IX="0">
            <NoFill>0</NoFill>
