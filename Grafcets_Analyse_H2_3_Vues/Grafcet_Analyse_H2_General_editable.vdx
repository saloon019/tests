          <Prop ID="4" NameU="Texte_complet">
            <Value Unit="STR">ÉTAPE 20
SHELTER STAND {N° stand}
{type d’analyse : Trailer / Début / Milieu / Fin}
Contrôle Trailer :
Vérifier que la vanne 60-DB-{N° stand}03 est fermée</Value>
            <Label Unit="STR">Texte_complet</Label>
            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
