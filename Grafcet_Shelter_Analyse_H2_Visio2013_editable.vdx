            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
          <Prop ID="7" NameU="Entete_R5">
            <Value Unit="STR">CONCAT(IN1 := WSTRING#'ETAPE N° ', IN2 := DELETE(IN := INT_TO_WSTRING(G7.G_X), L := 1, P := 1), IN3 := S_CRLF, IN4 := WSTRING#'SHELTER STAND ', IN5 := S_N_Stand, IN6 := S_CRLF, IN7 := S_Type, IN8 := S_CRLF)</Value>
