          <Prop ID="6" NameU="Expressions_sources">
            <Value Unit="STR">[{"network": 35, "writer_part": "46", "destination": "Ech_Stand_Analyse.Analyseur.Popup_Temp_Analyse_IHM_ENV.Message", "source_expression": "CONCAT(in1 := S_Num_Stand, in2 := Temp_Wstring)", "scl_networks": [34]}]</Value>
