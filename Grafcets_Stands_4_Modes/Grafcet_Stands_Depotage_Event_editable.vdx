          </Prop>
          <Prop ID="6" NameU="Popup_externe">
            <Value Unit="STR">[{"number": 255, "title": "POPUP POUR SPV priorité à l'analyseur", "scl": "\nIF Ech_Stand_Analyse.Analyseur.Popup_Temp_Analyse_SPV_ENV.Aff THEN\n    Popup_Temp_Stand.SPV.RCP := PopUp_RAZ_RCP;\n    Popup.SPV.ENV := Ech_Stand_Analyse.Analyseur.Popup_Temp_Analyse_SPV_ENV;\n    Ech_Stand_Analyse.Stands.Popup_Temp_Analyse_SPV_RCP := Popup.SPV.RCP;\nELSIF\n    Popup_Temp_Stand.SPV.ENV.Aff THEN\n    Ech_Stand_Analyse.Stands.Popup_Temp_Analyse_SPV_RCP := PopUp_RAZ_RCP;\n    Popup.SPV.ENV := Popup_Temp_Stand.SPV.ENV;\n    Popup_Temp_Stand.SPV.RCP := Popup.SPV.RCP;\nELSE\n    Popup.SPV.ENV := PopUp_RAZ_ENV;\n    Popup.SPV.RCP :=  PopUp_RAZ_RCP;\n    Ech_Stand_Analyse.Analyseur.Popup_Temp_Analyse_SPV_ENV := PopUp_RAZ_ENV;\n    Ech_Stand_Analyse.Stands.Popup_Temp_Analyse_SPV_RCP := PopUp_RAZ_RCP;\n    Popup_Temp_Stand.SPV.ENV := PopUp_RAZ_ENV;\n    Popup_Temp_Stand.SPV.RCP := PopUp_RAZ_RCP;\nEND_IF;\n\n\nIF Ech_Stand_Analyse.Analyseur.Popup_Temp_Analyse_IHM_ENV.Aff THEN\n    Popup_Temp_Stand.IHM.RCP := PopUp_RAZ_RCP;\n    Popup.IHM.ENV := Ech_Stand_Analyse.Analyseur.Popup_Temp_Analyse_IHM_ENV;\n    Ech_Stand_Analyse.Stands.Popup_Temp_Analyse_IHM_RCP := Popup.IHM.RCP;\nELSIF\n    Popup_Temp_Stand.IHM.ENV.Aff THEN\n    Ech_Stand_Analyse.Stands.Popup_Temp_Analyse_IHM_RCP := PopUp_RAZ_RCP;\n    Popup.IHM.ENV := Popup_Temp_Stand.IHM.ENV;\n    Popup_Temp_Stand.IHM.RCP := Popup.IHM.RCP;\nELSE\n    Popup.IHM.ENV := PopUp_RAZ_ENV;\n    Popup.IHM.RCP := PopUp_RAZ_RCP;\n    Ech_Stand_Analyse.Analyseur.Popup_Temp_Analyse_IHM_ENV := PopUp_RAZ_ENV;\n    Ech_Stand_Analyse.Stands.Popup_Temp_Analyse_IHM_RCP := PopUp_RAZ_RCP;\n    Popup_Temp_Stand.IHM.ENV := PopUp_RAZ_ENV;\n    Popup_Temp_Stand.IHM.RCP := PopUp_RAZ_RCP;\nEND_IF;\n\n\nIF (Popup.SPV.RCP.Reponse XOR (Popup.SPV.RCP.Reponse AND Reponse_SPV_mem)) &lt;&gt; 0 THEN\n    Popup.SPV.RCP := PopUp_RAZ_RCP;\nEND_IF;\nReponse_SPV_mem := Popup.SPV.RCP.Reponse;\nIF (Popup.IHM.RCP.Reponse XOR (Popup.IHM.RCP.Reponse AND Reponse_IHM_mem)) &lt;&gt; 0 THEN\n    Popup.IHM.RCP := PopUp_RAZ_RCP;\nEND_IF;\nReponse_IHM_mem := Popup.IHM.RCP.Reponse;"}]</Value>
            <Label Unit="STR">Popup_externe</Label>
            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
