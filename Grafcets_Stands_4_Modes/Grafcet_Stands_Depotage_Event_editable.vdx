          <Prop ID="5" NameU="RAZ_demandes">
            <Value Unit="STR">[{"network": 8, "part": "83", "targets": ["Parametres.Dde_Remplissage_Trailer"], "condition": "((G7.X[10] ET Fct.State_Run ET Parametres.Dde_Remplissage_Trailer) OU (G7.X[10] ET Fct.State_Run ET Parametres.Dde_Analyse_Trailer) OU (G7.X[10] ET Fct.State_Run ET Parametres.Depotage.Dde_Depotage) OU (G7.X[10] ET Fct.State_Run ET Parametres.Depotage_Event.Dde_Depotage_Event)) ET BDD_SAGE.P_Max_Trailer &lt;&gt; 0.0 ET BDD_SAGE.P_remplissage_Trailer &lt;&gt; 0.0"}, {"network": 8, "part": "84", "targets": ["Parametres.Dde_Analyse_Trailer"], "condition": "((G7.X[10] ET Fct.State_Run ET Parametres.Dde_Remplissage_Trailer) OU (G7.X[10] ET Fct.State_Run ET Parametres.Dde_Analyse_Trailer) OU (G7.X[10] ET Fct.State_Run ET Parametres.Depotage.Dde_Depotage) OU (G7.X[10] ET Fct.State_Run ET Parametres.Depotage_Event.Dde_Depotage_Event)) ET BDD_SAGE.P_Max_Trailer &lt;&gt; 0.0 ET BDD_SAGE.P_remplissage_Trailer &lt;&gt; 0.0"}, {"network": 8, "part": "85", "targets": ["Parametres.Depotage.Dde_Depotage"], "condition": "((G7.X[10] ET Fct.State_Run ET Parametres.Dde_Remplissage_Trailer) OU (G7.X[10] ET Fct.State_Run ET Parametres.Dde_Analyse_Trailer) OU (G7.X[10] ET Fct.State_Run ET Parametres.Depotage.Dde_Depotage) OU (G7.X[10] ET Fct.State_Run ET Parametres.Depotage_Event.Dde_Depotage_Event)) ET BDD_SAGE.P_Max_Trailer &lt;&gt; 0.0 ET BDD_SAGE.P_remplissage_Trailer &lt;&gt; 0.0"}, {"network": 8, "part": "86", "targets": ["Parametres.Depotage_Event.Dde_Depotage_Event"], "condition": "((G7.X[10] ET Fct.State_Run ET Parametres.Dde_Remplissage_Trailer) OU (G7.X[10] ET Fct.State_Run ET Parametres.Dde_Analyse_Trailer) OU (G7.X[10] ET Fct.State_Run ET Parametres.Depotage.Dde_Depotage) OU (G7.X[10] ET Fct.State_Run ET Parametres.Depotage_Event.Dde_Depotage_Event)) ET BDD_SAGE.P_Max_Trailer &lt;&gt; 0.0 ET BDD_SAGE.P_remplissage_Trailer &lt;&gt; 0.0"}]</Value>
            <Label Unit="STR">RAZ_demandes</Label>
