          <Prop ID="4" NameU="Texte_complet">
            <Value Unit="STR">ÉTAPE 360 / STAND {N° stand}
Ouvrir la vanne 60-HV-{N° stand}19
Et ouvrir la vanne 60-HR-{N° stand}01 progressivement
60-PG-{N° stand}03 = 0 barg
60-PIT-{N° stand}01 &lt; 0,5 barg
Pression actuelle : {60PITx01}.{60PITx01 : décimales} barg</Value>
            <Label Unit="STR">Texte_complet</Label>
            <Type>0</Type>
            <Invisible>0</Invisible>
