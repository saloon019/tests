            <Value Unit="STR">[{"target": "Actions fonctionnelles", "value": "Etanch_60PITx01_OK := DeltaP_Etancheite &lt;= Parametres.Delta_P_Max_etanch. Etanch_60FITx01_OK := DeltaQ_Etancheite &lt;= Parametres.Delta_Q_Max_etanch. Les deux critères sont requis. L’égalité est conforme ; ABS traite les écarts positifs ou négatifs.", "condition": "Étape active", "network": "5.18.9.1 / 5.18.10.1"}]</Value>
