          <Prop ID="5" NameU="Regles_AF">
            <Value Unit="STR">[{"id": "M1", "scope": [300, 310, 320, 330, 340, 344, 345, 350, 360, 370, 380, 800], "condition": "14-PAH-001 OU 14-PAH-002", "action": "Alarme immédiate, sans arrêt par ces seuls seuils."}, {"id": "M2", "scope": [300, 310, 320, 330, 340, 344, 345, 350, 360, 370, 380, 800], "condition": "14-PAHH-001 OU perte de terre", "action": "Arrêter le cycle MP et fermer 15-XSV-009 ; suite PV-07."}, {"id": "M3", "scope": "Fonction AU du stand indépendante de l’étape ; effets MP représentés sans limiter sa portée physique", "condition": "AU terrain ou supervision", "action": "Fermer 15-XSV-009 et 60-XSV-008 ; suite PV-07. En évent, ces fermetures ne coupent pas le chemin manuel."}, {"id": "V1", "scope": [600, 610, 620, 640, 810], "condition": "Perte terre pendant dépotage évent", "action": "Alarme à l’opérateur uniquement ; aucune coupure du chemin manuel ajoutée. Surveillance maintenue pendant l’attente des fermetures de fin 810, avant désactivation 850."}, {"id": "V2", "scope": [600, 610, 620, 640, 810], "condition": "AU du stand pendant évent", "action": "Aucun effet d’arrêt de ce flux manuel selon l’AF ; pas de transition de coupure fictive."}]</Value>
            <Label Unit="STR">Regles_AF</Label>
            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
          <Prop ID="6" NameU="Test_XML">
            <Value Unit="STR">{"network": 35, "scl": "TON_Etancheite(IN := G7.X[180] AND Fct.State_Run, PT := INT_TO_TIME(Parametres.Tempo_etancheite) * 1000);\nS_TempRestant_Delta_Q_sec := CONCAT(IN1 := DELETE(IN := INT_TO_WSTRING(TIME_TO_INT(TON_Etancheite.PT / 1000) - TIME_TO_INT(TON_Etancheite.ET / 1000)), L := 1, P := 1), IN2 := WSTRING#' (s) ');\nIF G7.X[180] AND Fct.State_Run AND DB_Plc.B1s THEN\n    DeltaP_Etancheite := ABS(60PITx01 - Analyse_hist.P_etancheite);\n    DeltaQ_Etancheite := ABS(60FITx01 - Analyse_hist.Q_etancheite);\n    Etanch_60PITx01_OK := DeltaP_Etancheite &lt;= Parametres.Delta_P_Max_etanch;\n    Etanch_60FITx01_OK := DeltaQ_Etancheite &lt;= Parametres.Delta_Q_Max_etanch;\nEND_IF;\n\nIF G7.X[180] AND Fct.State_Run THEN\n    IF NOT TON_Etancheite.Q THEN\n        temp_Wstring := CONCAT(IN1 := WSTRING#'Delta étanchéité de pression : ', IN2 := DELETE(IN := DINT_TO_WSTRING(TRUNC(DeltaP_Etancheite)), L := 1, P := 1), IN3 := WSTRING#'.', IN4 := RIGHT(IN := DINT_TO_WSTRING(TRUNC(ABS(FRAC(DeltaP_Etancheite)) * 100.0) + 100), L := 2), IN5 := WSTRING#' barg / ', IN6 := S_CRLF);\n        temp_Wstring := CONCAT(IN1 := temp_Wstring, IN2 := WSTRING#'Delta étanchéité de débit : ', IN3 := DELETE(IN := DINT_TO_WSTRING(TRUNC(DeltaQ_Etancheite)), L := 1, P := 1), IN4 := WSTRING#'.', IN5 := RIGHT(IN := DINT_TO_WSTRING(TRUNC(ABS(FRAC(DeltaQ_Etancheite)) * 100.0) + 100), L := 2), IN6 := WSTRING#' kg/h / ', IN7 := S_CRLF);\n        temp_Wstring := CONCAT(IN1 := temp_Wstring, IN2 := WSTRING#'Temps restant : ', IN3 := S_TempRestant_Delta_Q_sec);\n        \n        temp_Wstring1 := CONCAT(IN1 := WSTRING#'Delta étanchéité de pression : ', IN2 := DELETE(IN := DINT_TO_WSTRING(TRUNC(DeltaP_Etancheite)), L := 1, P := 1), IN3 := WSTRING#'.', IN4 := RIGHT(IN := DINT_TO_WSTRING(TRUNC(ABS(FRAC(DeltaP_Etancheite)) * 100.0) + 100), L := 2), IN5 := WSTRING#' barg / ', IN6 := S_CRLF);\n        temp_Wstring1 := CONCAT(IN1 := temp_Wstring1, IN2 := WSTRING#'Delta étanchéité de débit : ', IN3 := DELETE(IN := DINT_TO_WSTRING(TRUNC(DeltaQ_Etancheite)), L := 1, P := 1), IN4 := WSTRING#'.', IN5 := RIGHT(IN := DINT_TO_WSTRING(TRUNC(ABS(FRAC(DeltaQ_Etancheite)) * 100.0) + 100), L := 2), IN6 := WSTRING#' kg/h / ', IN7 := S_CRLF);\n        temp_Wstring1 := CONCAT(IN1 := temp_Wstring1, IN2 := WSTRING#'Temps restant : ', IN3 := S_TempRestant_Delta_Q_sec);\n    ELSE\n        temp_Wstring := CONCAT(IN1 := WSTRING#'Test étanchéité en pression et débit terminée', IN2 := S_CRLF);\n        temp_Wstring1 := CONCAT(IN1 := WSTRING#'Test étanchéité en pression et débit terminée', IN2 := S_CRLF);\n    END_IF;\nEND_IF;", "confirmed_criteria": ["Etanch_60PITx01_OK", "Etanch_60FITx01_OK"], "comparison": "&lt;=", "absolute_deltas": true}</Value>
            <Label Unit="STR">Test_XML</Label>
            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
