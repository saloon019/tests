            <Value Unit="STR">Fct.State_Run ET PNPN_PROCESS_SAFETY.LECT.LECT_INFOS.15XSV009.Fdc_Ouv ET NON (PNPN_PROCESS_SAFETY.LECT.LECT_INFOS.60PIT105.Valeur &lt;= 84.0)</Value>
            <Label Unit="STR">Condition</Label>
            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
