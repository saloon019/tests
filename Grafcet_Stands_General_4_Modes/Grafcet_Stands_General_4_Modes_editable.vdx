          </Prop>
          <Prop ID="7" NameU="Commentaire_reseau">
            <Value Unit="STR">300 -&gt; Descente issue d'un cycle normal XX
305 -&gt; Descente issue d'une demande d'arrêt progressive (popup idem pour 315)
306 -&gt; Popup validation reprise remplissage opérateur 60XVx10 ouverte phase descente(popup idem pour 316)
310 -&gt; Descente issue d'une analyse non conforme XX
315 -&gt; Demande arrêt brutale (popup idem pour 305)
316 -&gt; Popup validation reprise remplissage opérateur 60XVx10 fermée (popup idem pour 306)</Value>
            <Label Unit="STR">Commentaire_reseau</Label>
            <Type>0</Type>
            <Invisible>0</Invisible>
          </Prop>
