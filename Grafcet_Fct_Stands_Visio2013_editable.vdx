          <Text><cp IX="0"/><pp IX="0"/>RUN = Fct.State_Run
FAULT = Fct.State_Fault
STOPPING = Fct.State_Stopping
ACTIVATE = Fct.State_Activate
IHM.OK / IHM.NON = bits %X0 / %X1 de Popup_Temp_Stand.IHM.RCP.Reponse
SPV.OK / SPV.NON = bits %X0 / %X1 de Popup_Temp_Stand.SPV.RCP.Reponse
FinAnalyse = Ech_Stand_Analyse.Analyseur.FinAnalyse
ARRÊT_PROGRESSIF = Parametres.Dde_Arret_Remplissage_prog
ARRÊT_BRUTAL = Parametres.Dde_Arret_Remplissage_brut
IHM.Valeur_Dint / IHM.Valeur_Real = champs de Popup_Temp_Stand.IHM.RCP</Text>
